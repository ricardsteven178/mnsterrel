local function buildGUI()
    local pg = LocalPlayer:WaitForChild("PlayerGui")

    local existing = pg:FindFirstChild("AutoRoomGUI")
    if existing then existing:Destroy() end

    local ScreenGui       = Instance.new("ScreenGui")
    ScreenGui.Name        = "AutoRoomGUI"
    ScreenGui.ResetOnSpawn = false
    ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    ScreenGui.IgnoreGuiInset = true
    ScreenGui.Parent      = pg

    -- ToggleBtn pojok kanan bawah
    local ToggleBtn             = Instance.new("TextButton")
    ToggleBtn.Name              = "ToggleBtn"
    ToggleBtn.Size              = UDim2.new(0, 30, 0, 30)
    ToggleBtn.Position          = UDim2.new(1, -38, 1, -38)
    ToggleBtn.AnchorPoint       = Vector2.new(1, 1)
    ToggleBtn.BackgroundColor3  = Color3.fromRGB(15, 15, 25)
    ToggleBtn.BorderSizePixel   = 0
    ToggleBtn.Text              = "−"
    ToggleBtn.TextColor3        = Color3.fromRGB(100, 220, 255)
    ToggleBtn.TextSize          = 20
    ToggleBtn.Font              = Enum.Font.GothamBold
    ToggleBtn.ZIndex            = 20
    ToggleBtn.Parent            = ScreenGui
    Instance.new("UICorner", ToggleBtn).CornerRadius = UDim.new(0, 6)
    do
        local s = Instance.new("UIStroke", ToggleBtn)
        s.Color = Color3.fromRGB(0, 180, 255)
        s.Thickness = 1
    end

    -- Panel utama
    local Panel                 = Instance.new("Frame")
    Panel.Name                  = "Panel"
    Panel.Size                  = UDim2.new(0, 285, 0, 345)
    Panel.Position              = UDim2.new(0, 700, 0, 200) -- default kanan
    Panel.AnchorPoint           = Vector2.new(0, 0)
    Panel.BackgroundColor3      = Color3.fromRGB(10, 10, 20)
    Panel.BorderSizePixel       = 0
    Panel.ClipsDescendants      = false
    Panel.ZIndex                = 5
    Panel.Visible               = true
    Panel.Parent                = ScreenGui
    Instance.new("UICorner", Panel).CornerRadius = UDim.new(0, 10)
    do
        local s = Instance.new("UIStroke", Panel)
        s.Color = Color3.fromRGB(0, 160, 255)
        s.Thickness = 1.2
        s.Transparency = 0.3
    end

    -- Header bar
    local Header                = Instance.new("Frame")
    Header.Name                 = "Header"
    Header.Size                 = UDim2.new(1, 0, 0, 36)
    Header.Position             = UDim2.new(0, 0, 0, 0)
    Header.BackgroundColor3     = Color3.fromRGB(0, 110, 195)
    Header.BorderSizePixel      = 0
    Header.ZIndex               = 6
    Header.Parent               = Panel
    Instance.new("UICorner", Header).CornerRadius = UDim.new(0, 10)

    local HeaderLabel           = Instance.new("TextLabel")
    HeaderLabel.Size            = UDim2.new(1, -36, 1, 0)
    HeaderLabel.Position        = UDim2.new(0, 10, 0, 0)
    HeaderLabel.BackgroundTransparency = 1
    HeaderLabel.Text            = "⚡ AUTO-ROOM"
    HeaderLabel.TextColor3      = Color3.fromRGB(255, 255, 255)
    HeaderLabel.TextSize        = 14
    HeaderLabel.Font            = Enum.Font.GothamBold
    HeaderLabel.TextXAlignment  = Enum.TextXAlignment.Left
    HeaderLabel.ZIndex          = 7
    HeaderLabel.Parent          = Header

    local CloseBtn              = Instance.new("TextButton")
    CloseBtn.Size               = UDim2.new(0, 26, 0, 26)
    CloseBtn.Position           = UDim2.new(1, -30, 0, 5)
    CloseBtn.BackgroundTransparency = 1
    CloseBtn.Text               = "X"
    CloseBtn.TextColor3         = Color3.fromRGB(255, 80, 80)
    CloseBtn.TextSize           = 15
    CloseBtn.Font               = Enum.Font.GothamBold
    CloseBtn.ZIndex             = 8
    CloseBtn.Parent             = Header

    -- Label helper
    local function makeLabel(posY, txt, color)
        local l                 = Instance.new("TextLabel")
        l.Size                  = UDim2.new(1, -16, 0, 20)
        l.Position              = UDim2.new(0, 8, 0, posY)
        l.BackgroundTransparency = 1
        l.Text                  = txt
        l.TextColor3            = color or Color3.fromRGB(200, 200, 220)
        l.TextSize              = 12
        l.Font                  = Enum.Font.Gotham
        l.TextXAlignment        = Enum.TextXAlignment.Left
        l.ZIndex                = 6
        l.Parent                = Panel
        return l
    end

    local y = 44
    makeLabel(y, "TARGET PLAYERS: "..CONFIG.TARGET_PLAYERS, Color3.fromRGB(100,255,180)); y+=22
    makeLabel(y, "SKIP DIALOGUE: "..(CONFIG.SKIP_DOCTOR_DIALOGUE and "ON" or "OFF"),
        CONFIG.SKIP_DOCTOR_DIALOGUE and Color3.fromRGB(100,220,100) or Color3.fromRGB(220,80,80)); y+=22
    makeLabel(y, "CHECK SHIFT: "..(CONFIG.CHECK_TOP_SHIFT and "ON (min "..CONFIG.TOP_SHIFT_MIN..")" or "OFF"),
        CONFIG.CHECK_TOP_SHIFT and Color3.fromRGB(100,220,100) or Color3.fromRGB(220,80,80)); y+=22
    makeLabel(y, "RANDOM ROOM: "..(CONFIG.RANDOM_ROOM and "ON" or "SEQUENTIAL"),
        CONFIG.RANDOM_ROOM and Color3.fromRGB(255,220,80) or Color3.fromRGB(180,180,220)); y+=28

    local div               = Instance.new("Frame")
    div.Size                = UDim2.new(1, -16, 0, 1)
    div.Position            = UDim2.new(0, 8, 0, y)
    div.BackgroundColor3    = Color3.fromRGB(0, 160, 255)
    div.BackgroundTransparency = 0.5
    div.BorderSizePixel     = 0
    div.ZIndex              = 6
    div.Parent              = Panel
    y += 8

    local StatusLabel       = makeLabel(y, "Status: Idle", Color3.fromRGB(160,160,200))
    StatusLabel.Size        = UDim2.new(1, -16, 0, 40)
    StatusLabel.TextWrapped = true
    y += 48

    local RoomScanLabel     = makeLabel(y, "Rooms: scanning...", Color3.fromRGB(140,210,255))
    RoomScanLabel.Size      = UDim2.new(1, -16, 0, 50)
    RoomScanLabel.TextWrapped = true
    y += 56

    local StartBtn              = Instance.new("TextButton")
    StartBtn.Size               = UDim2.new(1, -16, 0, 34)
    StartBtn.Position           = UDim2.new(0, 8, 0, y)
    StartBtn.BackgroundColor3   = Color3.fromRGB(0, 180, 80)
    StartBtn.BorderSizePixel    = 0
    StartBtn.Text               = "▶ START"
    StartBtn.TextColor3         = Color3.fromRGB(255, 255, 255)
    StartBtn.TextSize           = 13
    StartBtn.Font               = Enum.Font.GothamBold
    StartBtn.ZIndex             = 7
    StartBtn.Parent             = Panel
    Instance.new("UICorner", StartBtn).CornerRadius = UDim.new(0, 8)

    -- ============================================================
    --  DRAG — seluruh Panel bisa di-drag
    -- ============================================================
    local dragging, dragStart, dragOrigin = false, nil, nil

    Panel.Active = true

    Panel.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging   = true
            dragStart  = input.Position
            dragOrigin = Panel.AbsolutePosition
        end
    end)

    Panel.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
        and input.UserInputType ~= Enum.UserInputType.Touch then return end

        local delta = input.Position - dragStart
        local vp    = Workspace.CurrentCamera.ViewportSize
        local sz    = Panel.AbsoluteSize
        local nx    = math.clamp(dragOrigin.X + delta.X, 0, vp.X - sz.X)
        local ny    = math.clamp(dragOrigin.Y + delta.Y, 0, vp.Y - sz.Y)
        Panel.Position = UDim2.new(0, nx, 0, ny)
    end)

    -- ============================================================
    --  TOGGLE & CLOSE
    -- ============================================================
    local panelOpen = not CONFIG.START_MINIMIZED
    Panel.Visible = panelOpen
    ToggleBtn.Text = panelOpen and "−" or "+"

    ToggleBtn.MouseButton1Click:Connect(function()
        panelOpen = not panelOpen
        Panel.Visible = panelOpen
        ToggleBtn.Text = panelOpen and "−" or "+"
    end)

    CloseBtn.MouseButton1Click:Connect(function()
        _G.AutoRoomRunning = false
        _G.AutoRoomActive  = false
        ScreenGui:Destroy()
    end)

    -- ============================================================
    --  ROOM SCAN DISPLAY
    -- ============================================================
    local function updateRoomScan()
        local parts = {}
        for _, r in ipairs(ROOMS) do
            local s     = getRoomStatus(r.id)
            local count = getPlayerCountText(r.id) or "?/4"
            local icon  = s == "empty" and "🔵" or (s == "waiting" and "🟡" or (s == "full" and "🔴" or "⚪"))
            table.insert(parts, "R"..r.id..": "..icon.." "..count)
        end
        RoomScanLabel.Text = table.concat(parts, "  |  ")
    end

    -- ============================================================
    --  START / STOP
    -- ============================================================
    _G.AutoRoomActive = false
    local loopThread

    local function setStatus(txt)
        StatusLabel.Text = "Status: "..txt
    end

    StartBtn.MouseButton1Click:Connect(function()
        if _G.AutoRoomActive then
            _G.AutoRoomActive = false
            if loopThread then task.cancel(loopThread) end
            StartBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 80)
            StartBtn.Text = "▶ START"
            setStatus("Stopped.")
        else
            _G.AutoRoomActive = true
            StartBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
            StartBtn.Text = "■ STOP"
            setStatus("Running...")

            loopThread = task.spawn(function()
                while _G.AutoRoomActive and _G.AutoRoomRunning do
                    pcall(updateRoomScan)
                    runAutoRoom(function(msg)
                        setStatus(msg)
                        task.wait(0.05)
                    end)
                    task.wait(CONFIG.LOOP_DELAY)
                end
                setStatus("Idle.")
                StartBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 80)
                StartBtn.Text = "▶ START"
            end)
        end
    end)

    task.spawn(function()
        while _G.AutoRoomRunning do
            pcall(updateRoomScan)
            task.wait(2)
        end
    end)

    -- AUTO START
    if CONFIG.AUTO_START then
        task.wait(0.3)
        _G.AutoRoomActive = true
        StartBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        StartBtn.Text = "■ STOP"
        setStatus("Auto-started...")

        loopThread = task.spawn(function()
            while _G.AutoRoomActive and _G.AutoRoomRunning do
                pcall(updateRoomScan)
                runAutoRoom(function(msg)
                    setStatus(msg)
                    task.wait(0.05)
                end)
                task.wait(CONFIG.LOOP_DELAY)
            end
            setStatus("Idle.")
            StartBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 80)
            StartBtn.Text = "▶ START"
        end)
    end
end

