local CONFIG = {
    TARGET_PLAYERS       = 1, 
    SKIP_DOCTOR_DIALOGUE = true, 
    CHECK_TOP_SHIFT      = true,
    TOP_SHIFT_MIN        = 10,
    RANDOM_ROOM          = false,
    LOOP_DELAY           = 1.5,
    WAIT_TIMEOUT         = 120,
    AUTO_START           = true, -- true = auto langsung jalan saat script dieksekusi atau false = script diam dulu, tekan START manual
    START_MINIMIZED      = false, -- true = panel langsung terminimize saat script dieksekusi atau  false = panel langsung terbuka
}

-- ============================================================
--  ROOM DATA
-- ============================================================
local ROOMS = {
    { id = 3, cframe = CFrame.new(-90.7799225, 20.9798355, -40.8240433) },
    { id = 2, cframe = CFrame.new(-87.7799454, 20.9798355, -66.5740433) },
    { id = 1, cframe = CFrame.new(-92.5799408, 20.9798355, -99.0240479) },
}

-- ============================================================
--  SERVICES
-- ============================================================
local Players          = game:GetService("Players")
local RS               = game:GetService("ReplicatedStorage")
