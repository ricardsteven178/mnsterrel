-- ============================================================
--  UTILITY
-- ============================================================
local function safeGet(root, path)
    local cur = root
    for _, key in ipairs(path) do
        if cur == nil then return nil end
        local ok, res = pcall(function() return cur[key] end)
        if not ok or res == nil then return nil end
        cur = res
    end
    return cur
end

local function getRoomNode(id)
    return safeGet(Workspace, {"Rooms", "Room"..id})
end

local function getPlayerCountText(id)
    local n = getRoomNode(id)
    return n and safeGet(n, {"Sign","PlayerCount","UI","Label","Text"}) or nil
end

local function getTimerText(id)
    local n = getRoomNode(id)
    return n and safeGet(n, {"Sign","Time","UI","Label","Text"}) or nil
end

local function parseCount(text)
    if not text then return nil end
    return tonumber(text:match("^(%d+)/"))
end

-- ============================================================
--  ROOM STATUS
-- ============================================================
local function getRoomStatus(id)
    local count = parseCount(getPlayerCountText(id))
    if count == nil then return "unknown" end
    if count >= 4   then return "full"    end
    local timer = getTimerText(id)
    local timerEmpty = (timer == nil or timer == "" or timer == " ")
    if count == 0 and timerEmpty then return "empty" end
    return "waiting"
end

-- ============================================================
--  TOP SHIFT CHECK
-- ============================================================
local function checkTopShift()
    if not CONFIG.CHECK_TOP_SHIFT then return true end
    local char = LocalPlayer.Character
    if not char then return true end
    local label = safeGet(char, {"Head","PName","UI","shifts"})
    if not label then return true end
    local content = label.ContentText or label.Text or ""
    local num = tonumber(content:match("%d+"))
    if not num then return true end
    return num >= CONFIG.TOP_SHIFT_MIN
end

-- ============================================================
--  ROOM PICKER
-- ============================================================
local function pickRoom()
    local candidates = {}
    for _, room in ipairs(ROOMS) do
        if getRoomStatus(room.id) == "empty" then
            table.insert(candidates, room)
        end
    end
    if #candidates == 0 then return nil end
    if CONFIG.RANDOM_ROOM then
        return candidates[math.random(1, #candidates)]
    end
    return candidates[1]
end

-- ============================================================
--  TELEPORT
-- ============================================================
local function teleportToRoom(room)
    local char = LocalPlayer.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    hrp.CFrame = room.cframe
    return true
end

-- ============================================================
--  REMOTES
-- ============================================================
local function getPartyFrame()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return nil end
    return safeGet(pg, {"PartyRoom","Center","Frame"})
end

local function fireExit()
    pcall(function() RS.Util.Net["RE/ExitRoom"]:FireServer() end)
end

local function fireStart()
    pcall(function() RS.Util.Net["RE/Quickstart"]:FireServer() end)
end

local function fireSkipDialogue()
    pcall(function()
        RS.Util.Net["RE/SetDoctorDialogueSkipped"]:FireServer(true)
    end)
end

-- ============================================================
--  WAIT FOR PLAYERS
-- ============================================================
local function waitForTarget(roomId, target, timeout)
    local elapsed = 0
    while elapsed < timeout do
        local count = parseCount(getPlayerCountText(roomId))
        if count and count >= target then return true end
        task.wait(CONFIG.LOOP_DELAY)
        elapsed = elapsed + CONFIG.LOOP_DELAY
    end
    return false
end

-- ============================================================
--  MAIN FLOW
-- ============================================================
local function runAutoRoom(log)
    log("Scanning rooms...")

    if CONFIG.CHECK_TOP_SHIFT then
        if not checkTopShift() then
            log("Top Shift < "..CONFIG.TOP_SHIFT_MIN.." — abort.")
            return
        end
        log("Top Shift OK ✓")
    end

    local room = pickRoom()
    if not room then
        log("No empty room. Retrying...")
        return
    end
    log("Room "..room.id.." — Teleporting...")

    if not teleportToRoom(room) then
        log("Teleport failed.")
        return
    end

    -- Verify entry — cek jarak HRP ke tiap room, konfirmasi room terdekat
    log("Verifying entry...")
    local confirmedRoom = nil
    local elapsed = 0

    repeat
        task.wait(0.5)
        elapsed = elapsed + 0.5

        local char = LocalPlayer.Character
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then continue end

        local hrpPos   = hrp.Position
        local closest  = nil
        local closestDist = math.huge

        for _, r in ipairs(ROOMS) do
            local dist = (hrpPos - r.cframe.Position).Magnitude
            if dist < closestDist then
                closestDist = dist
                closest = r
            end
        end

        -- Konfirmasi: karakter dalam radius 15 unit dari room target
        -- DAN room itu punya timer jalan (artinya kita terdaftar)
        if closest and closestDist <= 15 then
            local timer = getTimerText(closest.id)
            local timerRunning = timer and timer ~= "" and timer ~= " "
            if timerRunning then
                confirmedRoom = closest
            end
        end

        log("Nearest: Room "..(closest and closest.id or "?").." | dist="..string.format("%.1f", closestDist).." | timer="..(getTimerText(closest and closest.id or 1) or "none"))

    until confirmedRoom ~= nil or elapsed >= 12

    if not confirmedRoom then
        log("Entry timeout. Retry...")
        fireExit()
        return
    end

    room = confirmedRoom
    log("Entered Room "..room.id.." ✓")
    task.wait(0.8)

    -- Skip Dialogue
-- Skip Dialogue — poll sampai Disable.Visible true (Leader tag dari server)
    if CONFIG.SKIP_DOCTOR_DIALOGUE then
        local checkmark = nil
        local waited = 0
        log("Waiting for Leader tag...")
        repeat
            task.wait(0.4)
            waited = waited + 0.4
            local frame = getPartyFrame()
            if frame then
                local disableBtn = frame:FindFirstChild("Disable")
                if disableBtn and disableBtn.Visible == true then
                    local img = disableBtn:FindFirstChild("Image")
                    checkmark = img and img:FindFirstChild("Checkmark")
                end
            end
        until checkmark ~= nil or waited >= 10

        if checkmark then
            pcall(function() checkmark.Visible = true end)
            task.wait(0.1)
        end

        -- Jalur yang confirmed work dari debugger
        pcall(function()
            RS.Util.Net["RE/SetDoctorDialogueSkipped"]:FireServer(true)
        end)
        log("Skip Dialogue ✓")
    end

    -- Wait for target players dengan live status
    if CONFIG.TARGET_PLAYERS > 1 then
        local elapsed2 = 0
        while elapsed2 < CONFIG.WAIT_TIMEOUT do
            local count = parseCount(getPlayerCountText(room.id))
            local timer = getTimerText(room.id) or "?s"
            log("Room "..room.id.." | ".. (count or "?").."/4 players | "..timer.." left")
            if count and count >= CONFIG.TARGET_PLAYERS then break end
            task.wait(CONFIG.LOOP_DELAY)
            elapsed2 = elapsed2 + CONFIG.LOOP_DELAY
        end
        local finalCount = parseCount(getPlayerCountText(room.id))
        if not finalCount or finalCount < CONFIG.TARGET_PLAYERS then
            log("Player wait timeout. Exiting...")
            fireExit()
            return
        end
        log("Players ready ✓")
    end

    log("Firing START!")
    fireStart()
    log("Round started ✓")
end

